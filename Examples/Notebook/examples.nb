Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ZHR", "=", 
   RowBox[{"CreateProcess", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<ProcessName\>\"", "->", "\"\<ZHR\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<loopmoms\>\"", "->", 
      RowBox[{"{", "l1h", "}"}]}], 
     RowBox[{"(*", 
      RowBox[{"h", " ", "means", " ", "hard", " ", "loop", " ", "momentum"}], 
      "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<extmomsind\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nb"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<kinematics\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"nb", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"n", "*", "nb"}], "->", "2"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<extramoms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"l1hc", ",", "p", ",", "k", ",", "kh", ",", "v"}], "}"}]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"hc", " ", "means", " ", "hard"}], "-", 
