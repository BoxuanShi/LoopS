Cell["Process Definitions", "Section",
 CellChangeTimes->{
  3.955943923016391*^9, {3.956232916401003*^9, 3.956232917227488*^9}, {
   3.956235611436076*^9, 3.9562356116063347`*^9}, {3.9577568900315247`*^9, 
   3.957756890172978*^9}, {3.965705664546192*^9, 
   3.965705671210621*^9}},ExpressionUUID->"2a86ae63-1244-4df4-8a88-\
b3f8e1392fcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"PionEMFF", "=", 
   RowBox[{"CreateProcess", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<ProcessName\>\"", "->", "\"\<PionEMFF\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<loopmoms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"l1", ",", "l2"}], "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "loop", " ", "momenta", " ", "may", " ", "appear", " ", "in", " ", 
       "the", " ", "calculation"}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<extmomsind\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"p", ",", "pp"}], "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "indepedent", " ", "momenta", " ", "may", " ", "appear", " ", "in", " ",
        "Feynman", " ", "integrals", " ", "denominator"}], "*)"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<kinematics\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"pp", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"p", "*", "pp"}], "->", 
         RowBox[{"1", "/", "2"}]}]}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"kinematics", " ", "of", " ", "\"\<extmomsind\>\""}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<extramoms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "extra", " ", "external", " ", "momenta", " ", "only", " ", "appear", 
       " ", "at", " ", "numerator"}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<indices\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"p", ",", "\[Mu]", ",", "\"\<dummyindices\>\"", ",", "pp"}], 
       "}"}]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"optional", ".", " ", "indepedent"}], " ", "momenta", " ", 
       "together", " ", "with", " ", "open", " ", "index"}], ",", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "order", " ", "will", " ", "affect", " ", "the", " ", 
        "returned", " ", "operator", " ", "basis"}], "..."}]}], "*)"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.955942544771962*^9, 3.95594257322078*^9}, {
   3.95594267764422*^9, 3.955942727061634*^9}, 3.955942782872075*^9, {
