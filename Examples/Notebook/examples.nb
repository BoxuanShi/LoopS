Cell[BoxData[{
 RowBox[{
  RowBox[{"MIformlist", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["l1", "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "+", 
            RowBox[{"a1", " ", "p"}], "+", 
            RowBox[{"a2", " ", "pp"}]}], ")"}], "2"]}], "}"}], ",", 
       RowBox[{"{", "l1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "pp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["p", "2"], "\[Rule]", "0"}], ",", 
         RowBox[{
          RowBox[{"p", " ", "pp"}], "\[Rule]", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{
          SuperscriptBox["pp", "2"], "\[Rule]", "0"}]}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["l1", "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "+", 
            RowBox[{"a1", " ", "p"}], "+", 
            RowBox[{"a2", " ", "pp"}]}], ")"}], "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "+", 
            RowBox[{"b1", " ", "p"}], "+", 
            RowBox[{"b2", " ", "pp"}]}], ")"}], "2"]}], "}"}], ",", 
       RowBox[{"{", "l1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "pp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["p", "2"], "\[Rule]", "0"}], ",", 
         RowBox[{
          RowBox[{"p", " ", "pp"}], "\[Rule]", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{
          SuperscriptBox["pp", "2"], "\[Rule]", "0"}]}], "}"}]}], "}"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MIsollist", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s1", "=", 
         RowBox[{"a1", " ", "a2"}]}], "}"}], ",", 
       RowBox[{
        FractionBox["1", "\[Epsilon]"], "+", 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"Log", "[", 
           RowBox[{"-", "s1"}], "]"}]}], ")"}], "+", 
        RowBox[{
         FractionBox["1", "12"], " ", "\[Epsilon]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"6", " ", 
            SuperscriptBox[
             RowBox[{"Log", "[", 
              RowBox[{"-", "s1"}], "]"}], "2"]}], "-", 
           RowBox[{"24", " ", 
            RowBox[{"Log", "[", 
             RowBox[{"-", "s1"}], "]"}]}], "-", 
           SuperscriptBox["\[Pi]", "2"], "+", "48"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"\[Epsilon]order", "[", "2", "]"}], "*", 
         SuperscriptBox["\[Epsilon]", "2"]}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s3", ",", "x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s3", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a1", "-", "b1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"a2", "-", "b2"}], ")"}]}]}], ";", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           FractionBox["a1", 
            RowBox[{"a1", "-", "b1"}]], ",", 
           FractionBox["a2", 
            RowBox[{"a2", "-", "b2"}]]}], "}"}]}], ";", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{"PolyLog", "[", 
             RowBox[{"2", ",", 
              FractionBox["x", "y"]}], "]"}], "+", 
            RowBox[{"PolyLog", "[", 
             RowBox[{"2", ",", 
              FractionBox[
               RowBox[{"1", "-", "y"}], 
               RowBox[{"1", "-", "x"}]]}], "]"}], "+", 
            RowBox[{"PolyLog", "[", 
             RowBox[{"2", ",", 
              FractionBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "x"}], ")"}], " ", "y"}], 
               RowBox[{"x", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", "y"}], ")"}]}]]}], "]"}], "-", 
            RowBox[{"PolyLog", "[", 
             RowBox[{"2", ",", 
              FractionBox["y", "x"]}], "]"}], "-", 
            RowBox[{"PolyLog", "[", 
             RowBox[{"2", ",", 
              FractionBox[
               RowBox[{"1", "-", "x"}], 
               RowBox[{"1", "-", "y"}]]}], "]"}], "-", 
            RowBox[{"PolyLog", "[", 
