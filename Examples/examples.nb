Cell[BoxData[{
 RowBox[{
  RowBox[{"ampLOZHR", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Spinor", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"q1", ",", "D"}], "]"}], ",", "0", ",", "u"}], "]"}], ".", 
     RowBox[{"GSD", "[", "n", "]"}], ".", 
     RowBox[{"GA", "[", "5", "]"}], ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"GSD", "[", "p", "]"}], "-", 
       RowBox[{"GSD", "[", "k", "]"}], "+", "mc"}], ")"}], ".", 
     RowBox[{"GAD", "[", "\[Mu]", "]"}], ".", 
     RowBox[{"Spinor", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"q2", ",", "D"}], "]"}], ",", "0", ",", "b"}], "]"}]}], "*", 
    FractionBox["1", 
     RowBox[{
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"n", ",", "p"}], "]"}], 
       RowBox[{"SPD", "[", 
        RowBox[{"nb", ",", 
         RowBox[{"p", "-", "k"}]}], "]"}]}], "-", 
      RowBox[{"mc", "^", "2"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ampLO2ZHR", "=", 
