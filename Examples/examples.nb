        RowBox[{"GSD", "[", "p", "]"}]}], ")"}], ".", 
      RowBox[{"GAD", "[", "\[Sigma]", "]"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"GSD", "[", "k", "]"}]}], "+", 
        RowBox[{"GSD", "[", "l1", "]"}], "+", 
        RowBox[{"GSD", "[", "p", "]"}]}], ")"}], ".", 
      RowBox[{"GAD", "[", "\[Alpha]", "]"}], ".", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"GA", "[", "5", "]"}]}], ")"}], ".", 
      RowBox[{"(", 
