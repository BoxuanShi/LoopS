         RowBox[{"FVD", "[", 
          RowBox[{"nb", ",", "\[Nu]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["np", "2"], " ", 
             RowBox[{"OPs", "[", "5", "]"}]}], 
            RowBox[{"2", " ", 
             SuperscriptBox["\[Epsilon]", "2"]}]], "+", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"mb", "-", 
               RowBox[{"2", " ", "np"}]}], ")"}], " ", 
             SuperscriptBox["np", "2"], " ", 
             RowBox[{"Log", "[", 
              FractionBox["np", "mb"], "]"}], " ", 
             RowBox[{"OPs", "[", "5", "]"}]}], 
            RowBox[{
             RowBox[{"-", "mb"}], "+", "np"}]], "+", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            SuperscriptBox["np", "2"], " ", 
            SuperscriptBox[
             RowBox[{"Log", "[", 
              FractionBox["np", "mb"], "]"}], "2"], " ", 
            RowBox[{"OPs", "[", "5", "]"}]}], "+", 
           FractionBox[
            RowBox[{
             RowBox[{
              SuperscriptBox["np", "2"], " ", 
              RowBox[{"OPs", "[", "5", "]"}]}], "-", 
             RowBox[{
              SuperscriptBox["np", "2"], " ", 
              RowBox[{"Log", "[", 
               FractionBox["np", "mb"], "]"}], " ", 
              RowBox[{"OPs", "[", "5", "]"}]}]}], "\[Epsilon]"], "+", 
           RowBox[{
            RowBox[{"OPs", "[", "5", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               FractionBox["1", "24"], " ", 
               SuperscriptBox["np", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"60", "+", 
                 SuperscriptBox["\[Pi]", "2"]}], ")"}]}], "-", 
              RowBox[{
               SuperscriptBox["np", "2"], " ", 
               RowBox[{"PolyLog", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"1", "-", 
                  FractionBox["mb", "np"]}]}], "]"}]}]}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"OPs", "[", "1", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                FractionBox["1", "12"]}], " ", 
               SuperscriptBox["np", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"48", "+", 
