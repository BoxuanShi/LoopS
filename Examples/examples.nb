Cell[BoxData[
 RowBox[{
  RowBox[{"AlgebrasDefinition", "[", "\"\<F2EMFF\>\"", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"p", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        FractionBox["np", "2"], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"nb", ",", "D"}], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["lamb", "2"], 
        FractionBox["nbp", "2"], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"n", ",", "D"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"k", ",", "D"}], "]"}], "=", 
      RowBox[{
       SuperscriptBox["lamb", "2"], " ", 
       RowBox[{"Momentum", "[", 
        RowBox[{"kS", ",", "D"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"v", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"nb", ",", "D"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"1", "/", "2"}], 
        RowBox[{"Momentum", "[", 
         RowBox[{"n", ",", "D"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kS", ",", "kS"}], "]"}], "=", "kS2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kS", ",", "n"}], "]"}], "=", "nkS"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kS", ",", "nb"}], "]"}], "=", "nbkS"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.951485541031954*^9, 3.951485724673871*^9}, {
