Cell[CellGroupData[{

Cell["Example-2: ZHR (Expand-by-region and power-counting)", "Chapter",
 CellChangeTimes->{{3.967181171960178*^9, 3.967181172484915*^9}, {
  3.967794191943334*^9, 3.967794193466138*^9}, {3.96781719959832*^9, 
  3.967817247883309*^9}},ExpressionUUID->"c854ccbd-f72a-4711-b5be-\
b07a9b73e209"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ZHR", "=", 
   RowBox[{"CreateProcess", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<ProcessName\>\"", "->", "\"\<ZHR\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<loopmoms\>\"", "->", 
      RowBox[{"{", "l1h", "}"}]}], 
     RowBox[{"(*", 
      RowBox[{"h", " ", "means", " ", "hard", " ", "loop", " ", "momentum"}], 
      "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<extmomsind\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nb"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<kinematics\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"nb", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"n", "*", "nb"}], "->", "2"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<extramoms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"l1hc", ",", "p", ",", "k", ",", "kh", ",", "v"}], "}"}]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"hc", " ", "means", " ", "hard"}], "-", 
      RowBox[{"collinear", " ", "loop", " ", "momentum"}]}], "*)"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.955942544771962*^9, 3.95594257322078*^9}, {
