     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"l1hc", ",", "D"}], "]"}], "=."}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"mc", "=."}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kh", ",", "kh"}], "]"}], "=."}], ";", "\[IndentingNewLine]", 
     RowBox[{
