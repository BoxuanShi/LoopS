      RowBox[{
       SuperscriptBox["lamb", "2"], " ", 
       RowBox[{"Momentum", "[", 
        RowBox[{"kS", ",", "D"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"v", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"nb", ",", "D"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"1", "/", "2"}], 
        RowBox[{"Momentum", "[", 
         RowBox[{"n", ",", "D"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kS", ",", "kS"}], "]"}], "=", "kS2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
