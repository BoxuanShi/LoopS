   3.957750965777427*^9}},ExpressionUUID->"2a637d80-de34-438c-aec7-\
d6002e3f735a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F2EMFF", "=", 
   RowBox[{"CreateProcess", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<ProcessName\>\"", "->", "\"\<F2EMFF\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<loopmoms\>\"", "->", 
      RowBox[{"{", "l1", "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "loop", " ", "momenta", " ", "may", " ", "appear", " ", "in", " ", 
       "the", " ", "calculation"}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<extmomsind\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nb"}], "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "indepedent", " ", "momenta", " ", "may", " ", "appear", " ", "in", " ",
        "feynman", " ", "integrals", " ", "denominator"}], "*)"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<kinematics\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"nb", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"n", " ", "nb"}], "->", "2"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<extmoms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nb", ",", "p", ",", "k", ",", "kS", ",", "v"}], 
       "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "all", " ", "external", " ", "momenta", " ", "may", " ", "appear", " ", 
       "in", " ", "the", " ", "calculation"}], "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"\"\<moms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
       "l1", ",", "p", ",", "k", ",", "kS", ",", "v", ",", "n", ",", "nb"}], 
       "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "all", " ", "momenta", " ", "may", " ", "appear", " ", "in", " ", "the",
        " ", "calculation"}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<indices\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
       "n", ",", "nb", ",", "k", ",", "kS", ",", "\[Mu]", ",", "\[Nu]", ",", 
        "\[Alpha]", ",", "p", ",", "v", ",", "\"\<dummyindices\>\""}], 
       "}"}]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "indepedent", " ", "momenta", " ", "together", " ", "with", " ", "open",
        " ", "index"}], ",", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "order", " ", "will", " ", "be", " ", "distributed", " ", 
        "to", " ", "DiracOrder", " ", "to", " ", "further", " ", "apply", " ",
         "the", " ", "operator", " ", "rules"}], "..."}]}], "*)"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
