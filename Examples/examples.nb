      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"FVD", "[", 
            RowBox[{"k", ",", "\[Nu]"}], "]"}], " ", 
           RowBox[{"GAD", "[", "\[Mu]", "]"}]}], "+", 
          RowBox[{
           RowBox[{"FVD", "[", 
            RowBox[{"p", ",", "\[Nu]"}], "]"}], " ", 
           RowBox[{"GAD", "[", "\[Mu]", "]"}]}], "-", 
          RowBox[{"2", " ", 
           RowBox[{"FVD", "[", 
            RowBox[{"k", ",", "\[Mu]"}], "]"}], " ", 
