Cell[BoxData[{
 RowBox[{
  RowBox[{"AlgebrasDefinition", "[", "\"\<ZHR\>\"", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"p", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        FractionBox["np", "2"], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"nb", ",", "D"}], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["lamb", "2"], 
        FractionBox["nbp", "2"], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"n", ",", "D"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"k", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{"lamb", "^", "2"}], "*", 
       RowBox[{"Momentum", "[", 
        RowBox[{"kh", ",", "D"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"v", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"nb", ",", "D"}], "]"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"Momentum", "[", 
         RowBox[{"n", ",", "D"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"l1hc", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"SPD", "[", 
          RowBox[{"n", ",", "l1h"}], "]"}], "2"], 
        RowBox[{"Momentum", "[", 
         RowBox[{"nb", ",", "D"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"lamb", "^", "2"}], "*", 
        FractionBox[
         RowBox[{"SPD", "[", 
          RowBox[{"nb", ",", "l1h"}], "]"}], "2"], 
        RowBox[{"Momentum", "[", 
         RowBox[{"n", ",", "D"}], "]"}]}], "+", 
       RowBox[{"lamb", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Momentum", "[", 
           RowBox[{"l1h", ",", "D"}], "]"}], "-", 
          RowBox[{
           FractionBox[
            RowBox[{"SPD", "[", 
             RowBox[{"n", ",", "l1h"}], "]"}], "2"], 
           RowBox[{"Momentum", "[", 
            RowBox[{"nb", ",", "D"}], "]"}]}], "-", 
          RowBox[{
           FractionBox[
            RowBox[{"SPD", "[", 
             RowBox[{"nb", ",", "l1h"}], "]"}], "2"], 
           RowBox[{"Momentum", "[", 
            RowBox[{"n", ",", "D"}], "]"}]}]}], ")"}]}]}]}], 
     RowBox[{"(*", 
      RowBox[{
      "expr", " ", "in", " ", "the", " ", "parenthesis", " ", "is", " ", 
       "the", " ", "definition", " ", "of", " ", "transverse", " ", "loop", 
       " ", "momentum"}], "*)"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mc", "=", 
      RowBox[{"lamb", "*", "mch"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kh", ",", "kh"}], "]"}], "=", "kh2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kh", ",", "n"}], "]"}], "=", "nkh"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SPD", "[", 
       RowBox[{"kh", ",", "nb"}], "]"}], "=", "nbkh"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearProcess", "[", "\"\<ZHR\>\"", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "Nothing"}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
