       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"ampLO", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "//", "SUNSimplify"}], "//", 
         "FCES"}], "//", "FactorAll"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
