     RowBox[{"(*", 
      RowBox[{"h", " ", "means", " ", "hard", " ", "loop", " ", "momentum"}], 
      "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<extmomsind\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nb"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<kinematics\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"nb", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"n", "*", "nb"}], "->", "2"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<extramoms\>\"", "->", 
