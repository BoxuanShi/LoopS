Cell[BoxData[
 RowBox[{
  RowBox[{"PionEMFF", "=", 
   RowBox[{"CreateProcess", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<ProcessName\>\"", "->", "\"\<PionEMFF\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<loopmoms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"l1", ",", "l2"}], "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "loop", " ", "momenta", " ", "may", " ", "appear", " ", "in", " ", 
       "the", " ", "calculation"}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<extmomsind\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"p", ",", "pp"}], "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "indepedent", " ", "momenta", " ", "may", " ", "appear", " ", "in", " ",
        "feynman", " ", "integrals", " ", "denominator"}], "*)"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<kinematics\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"pp", "^", "2"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{"p", "*", "pp"}], "->", 
         RowBox[{"1", "/", "2"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<extramoms\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}], 
     RowBox[{"(*", 
      RowBox[{
      "extra", " ", "external", " ", "momenta", " ", "only", " ", "appear", 
       " ", "at", " ", "numerator"}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<indices\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"p", ",", "\[Mu]", ",", "\"\<dummyindices\>\"", ",", "pp"}], 
       "}"}]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "indepedent", " ", "momenta", " ", "together", " ", "with", " ", "open",
        " ", "index"}], ",", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "order", " ", "will", " ", "be", " ", "distributed", " ", 
        "to", " ", "DiracOrder", " ", "to", " ", "further", " ", "apply", " ",
         "the", " ", "operator", " ", "rules"}], "..."}]}], "*)"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
