Cell["Example-2: F2EMFF with power-counting [Given by Hao-Yi Ci]", "Chapter",
 CellChangeTimes->{
  3.957614330206759*^9, {3.9576713042409153`*^9, 3.957671305902182*^9}, {
   3.957671403315448*^9, 3.957671408294681*^9}, {3.957671636494025*^9, 
