  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{"p", ",", "D"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        FractionBox["np", "2"], " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"nb", ",", "D"}], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["lamb", "2"], 
        FractionBox["nbp", "2"], " ", 
        RowBox[{"Momentum", "[", 
