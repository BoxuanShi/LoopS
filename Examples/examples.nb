Cell[BoxData[{
 RowBox[{
  RowBox[{"MIformlist", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["l1", "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "+", 
            RowBox[{"a1", " ", "p"}], "+", 
            RowBox[{"a2", " ", "pp"}]}], ")"}], "2"]}], "}"}], ",", 
       RowBox[{"{", "l1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "pp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
