Cell[BoxData[{
 RowBox[{
  RowBox[{"deno", "=", 
   RowBox[{"FAD", "[", 
    RowBox[{"l1", ",", 
     RowBox[{"l1", "+", "p", "-", "k"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l1", "+", 
        RowBox[{"mb", " ", "v"}], "-", "k"}], ",", "mb"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"deno", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"deno", "//", "FCI"}], "//", "ExpandMomentum"}], "//", 
        "FeynAmpDenominatorExplicit"}], "//", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"lamb", ",", "0", ",", "2"}], "}"}]}], "]"}], "&"}]}], "//",
       "Normal"}], "//", "FCES"}], "//", 
    RowBox[{
     RowBox[{"SPDToFAD", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", "l1", "}"}]}], "]"}], "&"}]}]}], ";"}]}], "Input",
