  RowBox[{"(*", 
   RowBox[{
   "MIsollist", " ", "encodes", " ", "the", " ", "integral", " ", "results", 
    " ", "with", " ", "corresponding", " ", 
    RowBox[{"integrands", "."}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.965703151141073*^9, 3.96570319411654*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"89a8c984-b15f-4f10-8523-dde9381bc11a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MIformlist", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["l1", "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "+", 
            RowBox[{"a1", " ", "p"}], "+", 
            RowBox[{"a2", " ", "pp"}]}], ")"}], "2"]}], "}"}], ",", 
       RowBox[{"{", "l1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "pp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["p", "2"], "\[Rule]", "0"}], ",", 
         RowBox[{
          RowBox[{"p", " ", "pp"}], "\[Rule]", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{
          SuperscriptBox["pp", "2"], "\[Rule]", "0"}]}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["l1", "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "+", 
            RowBox[{"a1", " ", "p"}], "+", 
            RowBox[{"a2", " ", "pp"}]}], ")"}], "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "+", 
            RowBox[{"b1", " ", "p"}], "+", 
            RowBox[{"b2", " ", "pp"}]}], ")"}], "2"]}], "}"}], ",", 
       RowBox[{"{", "l1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "pp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["p", "2"], "\[Rule]", "0"}], ",", 
         RowBox[{
          RowBox[{"p", " ", "pp"}], "\[Rule]", 
          FractionBox["1", "2"]}], ",", 
         RowBox[{
          SuperscriptBox["pp", "2"], "\[Rule]", "0"}]}], "}"}]}], "}"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MIsollist", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"2", "+", 
      FractionBox["1", "\[Epsilon]"], "+", 
      RowBox[{"HOrder1", "*", 
       SuperscriptBox["\[Epsilon]", "2"]}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"-", "a1"}], " ", "a2"}], "]"}], "+", 
      RowBox[{
       FractionBox["1", "12"], " ", "\[Epsilon]", " ", 
       RowBox[{"(", 
        RowBox[{"48", "-", 
         SuperscriptBox["\[Pi]", "2"], "-", 
         RowBox[{"24", " ", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"-", "a1"}], " ", "a2"}], "]"}]}], "+", 
         RowBox[{"6", " ", 
          SuperscriptBox[
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"-", "a1"}], " ", "a2"}], "]"}], "2"]}]}], ")"}]}]}], 
     ",", 
     RowBox[{
      RowBox[{"HOrder2", "*", "\[Epsilon]"}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a1", "-", "b1"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["a1", 
            RowBox[{"a1", "-", "b1"}]], "-", 
           FractionBox["a2", 
            RowBox[{"a2", "-", "b2"}]]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"a2", "-", "b2"}], ")"}]}]], 
