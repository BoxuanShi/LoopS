Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ampLO", "=", 
    RowBox[{"<<", "\"\<ampLO\>\""}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"import", " ", "Feynman", " ", 
    RowBox[{"amplitudes", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ampLO2", "=", 
    RowBox[{
     RowBox[{"TableS", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"ampLO", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "//", "SUNSimplify"}], "//", 
         "FCES"}], "//", "FactorAll"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "@", "ampLO"}]}], "}"}]}], "]"}], "//", 
     "TimingS"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "do", " ", "color", " ", "algebras", " ", "and", " ", "FactorAll", " ", 
    "to", " ", "derive", " ", "a", " ", "unique", " ", "form", " ", "before", 
    " ", 
    RowBox[{"abbreviation", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ampLO3", ",", "colRulesLO"}], "}"}], "=", 
    RowBox[{
     RowBox[{"AbbreviateFactor", "[", 
      RowBox[{"ampLO2", ",", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"#", ",", 
           RowBox[{"CA", "|", "CF"}]}], "]"}]}], "&"}], ",", 
       RowBox[{"\"\<AbbreviateFactorName\>\"", "->", "colLO"}]}], "]"}], "//",
      "TimingS"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"abbreviate", " ", "color", " ", 
    RowBox[{"factors", ".", " ", "colRulesLO"}], " ", "preserves", " ", "the",
     " ", "complete", " ", "information", " ", "needed", " ", "to", " ", 
    "recover", " ", "the", " ", "original", " ", 
    RowBox[{"amplitudes", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ampLO4", ",", "gatherInfoLO"}], "}"}], "=", 
    RowBox[{
     RowBox[{"GatherAmplitudes", "[", "ampLO3", "]"}], "//", "TimingS"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "merge", " ", "amplitudes", " ", "that", " ", "differ", " ", "only", " ", 
    "by", " ", "constant", " ", "coefficients", " ", "to", " ", "avoid", " ", 
    "redundant", " ", "calculations", " ", "in", " ", "the", " ", 
    RowBox[{"future", ".", " ", "gatherInfoLO"}], " ", "preserves", " ", 
    "the", " ", "complete", " ", "information", " ", "needed", " ", "to", " ",
     "recover", " ", "the", " ", "original", " ", 
    RowBox[{"amplitudes", "."}]}], "*)"}]}]}], "Input",
