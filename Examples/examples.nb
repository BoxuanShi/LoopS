  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "IBPReduction[Fslist_List, family_List, loops_List, extmomsind_List, \
kinematics_List, {WorkPath_String, FamilyName_String}, opt : \
OptionsPattern[]].\n\"IBPReductionRange\": _List|All : All -> determine which \
family to reduce.\nDepending options: {FIREIBPReduction, TableS}.\nWARN: \
Parallelization in MMA and in the external IBP program are independent. The \
total number of cores used equals their product.", "Documentation" -> None, 
    "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, LoopS`IBPReduction, {LoopS`IBPReduction[
         Pattern[LoopS`Private`Fslist, 
          Blank[List]], 
         Pattern[LoopS`Private`family, 
          Blank[List]], 
         Pattern[LoopS`Private`loops, 
          Blank[List]], 
         Optional[
          Pattern[LoopS`Private`process, 
           Blank[Association]], LoopS`CurrentProcess], 
         Pattern[LoopS`Private`opt, 
          OptionsPattern[]]] :> Switch[
         OptionValue["IBPReducer"], "FIRE", 
         LoopS`IBPReduction[
         LoopS`Private`Fslist, LoopS`Private`family, LoopS`Private`loops, 
          LoopS`Private`process["extmomsind"], 
          LoopS`Private`process["kinematics"], {
           LoopS`FIREWorkPath[
            LoopS`Private`process["ProcessName"]], 
           LoopS`FIREFamilyName[LoopS`Private`loops]}, 
          Evaluate[LoopS`Private`opt]]], LoopS`IBPReduction[
         Pattern[LoopS`Private`Fslist, 
          Blank[List]], 
         Pattern[LoopS`Private`family, 
          Blank[List]], 
         Pattern[LoopS`Private`loops, 
          Blank[List]], 
         Pattern[LoopS`extmomsind, 
          Blank[List]], 
         Pattern[LoopS`kinematics, 
          Blank[List]], {
          Pattern[LoopS`Private`WorkPath, 
           Blank[String]], 
          Pattern[LoopS`Private`FamilyName, 
           Blank[String]]}, 
         Pattern[LoopS`Private`opt, 
          OptionsPattern[]]] :> 
       Module[{LoopS`Private`i, LoopS`Private`rg, LoopS`Private`glistInfam, 
          LoopS`Private`ibp1, LoopS`Private`ibprules, 
          LoopS`Private`ibpgAndMI}, 
         LoopS`Private`rg = OptionValue["IBPReductionRange"]; 
         If[LoopS`Private`rg === All, LoopS`Private`rg = Range[
             Length[LoopS`Private`family]]]; 
         LoopS`Private`glistInfam = 
          LoopS`GatherGInFamily[LoopS`Private`Fslist, LoopS`Private`family]; 
         LoopS`Private`ibp1 = LoopS`TableS[
            LoopS`FIREIBPReduction[
             Part[LoopS`Private`glistInfam, LoopS`Private`i], {
             LoopS`Private`family, LoopS`Private`i}, LoopS`Private`loops, 
             LoopS`extmomsind, LoopS`kinematics, {
             LoopS`Private`WorkPath, LoopS`Private`FamilyName}, 
             Evaluate[
              
              LoopS`FilterOptions[{LoopS`Private`opt}, 
               LoopS`FIREIBPReduction]]], {LoopS`Private`i, LoopS`Private`rg}, 
            Evaluate[
             LoopS`FilterOptions[{LoopS`Private`opt}, LoopS`TableS]]]; 
         LoopS`Private`ibp1 = 
          Flatten[LoopS`Private`ibp1]; {
           LoopS`Private`ibprules, LoopS`Private`ibpgAndMI} = {
            Dispatch[LoopS`Private`ibp1], {
             LoopS`getS[
              Part[LoopS`Private`ibp1, All, 1], 
              Blank[$CellContext`G]], 
             LoopS`getS[
              Part[LoopS`Private`ibp1, All, 2], 
              Blank[$CellContext`G]]}}; {
          LoopS`Private`ibprules, LoopS`Private`ibpgAndMI}]}], "SubValues" -> 
    None, "DefaultValues" -> 
    Information`InformationValueForm[
     DefaultValues, LoopS`IBPReduction, {
      Options[LoopS`IBPReduction] :> 
       LoopS`CreateOptions[{
         "IBPReducer" -> "FIRE", "IBPReductionRange" -> All}, {
         LoopS`FIREIBPReduction, LoopS`TableS}]}], "NValues" -> None, 
    "FormatValues" -> None, "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "LoopS`IBPReduction"|>, False]]], "Output",
