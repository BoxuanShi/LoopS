Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AlgebrasDefinition", "[", "\"\<PionEMFF\>\"", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Momentum", "[", 
