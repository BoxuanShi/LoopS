Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AlgebrasDefinition", "[", "\"\<PionEMFF\>\"", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"p1", ",", "D"}], "]"}], "=", 
       RowBox[{"x1", " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p", ",", "D"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"p2", ",", "D"}], "]"}], "=", 
       RowBox[{"x2", " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p", ",", "D"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"p3", ",", "D"}], "]"}], "=", 
       RowBox[{"y1", " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"pp", ",", "D"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"p4", ",", "D"}], "]"}], "=", 
       RowBox[{"y2", " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{"pp", ",", "D"}], "]"}]}]}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
