 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ampLO3", ",", "colRulesLO"}], "}"}], "=", 
    RowBox[{
     RowBox[{"AbbreviateFactor", "[", 
      RowBox[{"ampLO2", ",", 
       RowBox[{
        RowBox[{"!", 
