 RowBox[{
  RowBox[{"Get", "[", "\"\<FIRE6.m\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Internal", "=", 
   RowBox[{"{", 
    RowBox[{"k1", ",", "k2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"External", "=", 
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Propagators", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"k1", "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1", "+", "p1", "+", "p2"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{"k2", "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k2", "+", "p1", "+", "p2"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1", "+", "p1"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1", "-", "k2"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k2", "-", "p3"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k2", "+", "p1"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1", "-", "p3"}], ")"}], "^", "2"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Replacements", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"p1", "^", "2"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"p2", "^", "2"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"p3", "^", "2"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"p1", " ", "p2"}], "\[Rule]", 
      RowBox[{"s", "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"p1", " ", "p3"}], "\[Rule]", 
      RowBox[{"t", "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"p2", " ", "p3"}], "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"s", "+", "t"}], ")"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CreateNewBasis", "[", 
   RowBox[{"b2", ",", 
    RowBox[{"Directory", "\[Rule]", "\"\<temp/b2.dir\>\""}]}], "]"}], 
  ";"}], "\n", 
