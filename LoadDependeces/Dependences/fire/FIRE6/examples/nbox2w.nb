  3.8835804308950863`*^9, 3.920648262932354*^9, {3.9207000046782837`*^9, 
   3.920700018573574*^9}, 3.9207005604699078`*^9},
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"0d6f9bf2-c191-44b8-8d36-4637d3611676"],

Cell[BoxData["\<\"Found 58 zero sectors out of 128.\\n    ZeroSectors[nbox2w] \
\[LongDash] zero sectors,\\n    NonZeroSectors[nbox2w] \[LongDash] nonzero \
sectors,\\n    SimpleSectors[nbox2w] \[LongDash] simple sectors (no nonzero \
subsectors),\\n    BasisSectors[nbox2w] \[LongDash] basis sectors (at least \
one immediate subsector is zero),\\n    ZerojRule[nbox2w] \[LongDash] a rule \
to nullify all zero j[nbox2w\[Ellipsis]],\\n    CutDs[nbox2w] \[LongDash] a \
flag list of cut denominatorsj (1=cut).\"\>"], "Print",
 CellChangeTimes->{
  3.8835804308950863`*^9, 3.920648262932354*^9, {3.9207000046782837`*^9, 
   3.920700018573574*^9}, 3.920700561726973*^9},
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"5d533165-3a06-43ea-9295-0d64b8d6e323"],

Cell[BoxData["\<\"Found 12 mapped sectors and 58 unique sectors.\\n    \
UniqueSectors[nbox2w] \[LongDash] unique sectors.\\n    MappedSectors[nbox2w] \
\[LongDash] mapped sectors.\\n    SR[nbox2w][\[Ellipsis]] \[LongDash] \
symmetry relations for j[nbox2w,\[Ellipsis]] from UniqueSectors[nbox2w].\\n   \
 jSymmetries[nbox2w,\[Ellipsis]] \[LongDash] symmetry rules for the sector \
js[nbox2w,\[Ellipsis]] in UniqueSectors[nbox2w].\\n    jRules[nbox2w,\
\[Ellipsis]] \[LongDash] reduction rules for j[nbox2w,\[Ellipsis]] from \
MappedSectors[nbox2w].\"\>"], "Print",
 CellChangeTimes->{
  3.8835804308950863`*^9, 3.920648262932354*^9, {3.9207000046782837`*^9, 
   3.920700018573574*^9}, 3.9207005787056217`*^9},
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"fbba54e8-bee9-49a0-83bd-a6529b324ae6"]
}, Open  ]],

