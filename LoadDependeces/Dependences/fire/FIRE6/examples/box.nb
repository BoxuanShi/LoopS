Cell[BoxData[{
 RowBox[{
  RowBox[{"list", "=", 
   RowBox[{"MasterIntegrals", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Internal", "=", " ", 
   RowBox[{"{", "k", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"External", "=", " ", 
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2", ",", "p4"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Propagators", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"k", "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "+", "p1"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "+", "p1", "+", "p2"}], ")"}], "^", "2"}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "+", "p1", "+", "p2", "+", "p4"}], ")"}], "^", "2"}]}]}],
     "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Replacements", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"p1", "^", "2"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"p2", "^", "2"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"p4", "^", "2"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"p1", " ", "p2"}], "\[Rule]", 
      RowBox[{
       RowBox[{"-", "S"}], "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"p2", " ", "p4"}], "\[Rule]", 
      RowBox[{
       RowBox[{"-", "T"}], "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"p1", " ", "p4"}], "\[Rule]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"S", "+", "T"}], ")"}], "/", "2"}]}], ",", 
     RowBox[{"S", "\[Rule]", "1"}], ",", 
     RowBox[{"T", "\[Rule]", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WriteRules", "[", 
   RowBox[{"list", ",", "\"\<examples/box\>\""}], "]"}], ";"}]}], "Input",
