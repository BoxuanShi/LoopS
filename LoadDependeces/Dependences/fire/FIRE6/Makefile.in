include paths.inc

default:
	$(MAKE) -C ./poly
	$(MAKE) -C ./prime
	$(MAKE) -C ./tools

all:
	$(MAKE) -C ./poly
	$(MAKE) -C ./prime
	$(MAKE) -C ./mpi

poly:
	$(MAKE) -C ./poly

tools:
	$(MAKE) -C ./tools

prime:
	$(MAKE) -C ./prime

.PHONY: mpi poly prime
mpi:
	$(MAKE) -C ./mpi

test:
	make -f tests.makefile

testmath:
	make -f tests.makefile math

.PHONY: doc documentation doc_pdf showdoc
doc: documentation

documentation:
	doxygen ./documentation/Doxyfile

showdoc:
	xdg-open documentation/html/index.html

doc_pdf:
	if [ ! -f documentation/latex/Makefile ]; then $(MAKE) doc; fi;
	$(MAKE) -C ./documentation/latex/
	mv ./documentation/latex/refman.pdf ./documentation/

.PHONY: cleandoc
cleandoc:
	rm -rf ./documentation/latex/
	rm -rf ./documentation/html/
	rm -f ./documentation/refman.pdf

pvs:
	make clean
	make cleanbin
	pvs-studio-analyzer trace -- make poly
	pvs-studio-analyzer analyze -o temp/poly.log -e usr/
	plog-converter -d V1042 -a GA:1,2 -t tasklist -o temp/poly.tasks temp/poly.log
	pvs-studio-analyzer trace -- make prime
	pvs-studio-analyzer analyze -o temp/prime.log -e usr/
	plog-converter -d V1042 -a GA:1,2 -t tasklist -o temp/prime.tasks temp/prime.log

.PHONY: cleanall
cleanall: clean cleanbin cleanbak cleandep cleantemp cleandoc cleanmake

.PHONY: cleanmake
cleanmake:
	rm -f Makefile mpi/Makefile poly/Makefile prime/Makefile

.PHONY: clean
clean:
	rm -f mpi/*.o
	rm -f poly/*.o
	rm -f prime/*.o

.PHONY: cleanbin
cleanbin:
	cd mpi && $(MAKE) clean
	rm -f poly/FIRE6 poly/FLAME6 poly/Ftool6
	rm -f prime/FIRE6 prime/FLAME6 prime/Ftool6

.PHONY: cleanbak
cleanbak:
	rm -f sources/*~
	rm -f sources/*backup
	rm -f sources/*bak
	rm -f sources/*kate-swp
	rm -f *~
	rm -f *backup
	rm -f *bak

.PHONY: cleantemp
cleantemp:
	rm -rf temp/*

dep: depend

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
ASIE = AS_INTEGRATED_ASSEMBLER=1
else
ASIE =
endif

ifdef ENABLE_TCMALLOC
tcmalloc:
	export CXX=$(CCPLUS) && export CC=$(CC) && cd extra/gperftools-2.7/ && ./configure --enable-minimal --prefix=`pwd`/../../usr/
	$(MAKE) -C ./extra/gperftools-2.7
	$(MAKE) -C ./extra/gperftools-2.7 install
else
tcmalloc:
endif

ifdef ENABLE_TCMALLOC
cleantcmalloc:
	if [ -f extra/gperftools-2.7/Makefile ]; then $(MAKE) -C ./extra/gperftools-2.7 clean; fi;
else
cleantcmalloc:
endif

.PHONY: submodule fuel snappy lz4 zstd
submodule:
	cd .. && git submodule update --init --recursive

fuel: submodule
	cd extra/fuel && ./configure $(SYMBOLICA_OPTION) $(FLINT_OPTION) $(PREBUILT_MPFR_OPTION) $(PREBUILT_GMP_OPTION) --cpp=$(CCPLUS) --cc=$(CC)
	$(MAKE) -C extra/fuel dep
	$(MAKE) -C extra/fuel library
	cp extra/fuel/library/libfuel.a usr/lib/

ifdef ENABLE_SNAPPY
snappy:
	export CXX=$(CCPLUS) && export CC=$(CC) && cd extra/snappy-1.1.7/ && mkdir -p build && cd build && cmake ../
	$(MAKE) -C ./extra/snappy-1.1.7/build
	$(MAKE) -C ./extra/snappy-1.1.7/build DESTDIR=../../../ install
else
snappy:
endif

ifdef ENABLE_ZSTD
zstd:
	export CXX=$(CCPLUS) && export CC=$(CC) && $(MAKE) -C ./extra/zstd-1.4.3
	$(MAKE) -C ./extra/zstd-1.4.3 PREFIX=`pwd`/usr/ uninstall
	$(MAKE) -C ./extra/zstd-1.4.3 PREFIX=`pwd`/usr/ install
else
zstd:
endif

depend: fuel tcmalloc snappy lz4 zstd
	export CXX=$(CCPLUS) && export CC=$(CC) && cd extra/kyotocabinet-1.2.77/ && ./configure --prefix=`pwd`/../../usr/ --disable-zlib
	$(ASIE) $(MAKE) -C ./extra/kyotocabinet-1.2.77
	$(MAKE) -C ./extra/kyotocabinet-1.2.77 install
	cp extra/FSBAllocator.hh usr/include/
	export CXX=$(CCPLUS) && export CC=$(CC) && $(MAKE) -C ./extra/lz4-1.9.2
	$(MAKE) -C ./extra/lz4-1.9.2 PREFIX=`pwd`/usr/ uninstall
	$(MAKE) -C ./extra/lz4-1.9.2 PREFIX=`pwd`/usr/ install

cleandep: cleantcmalloc
	rm -rf usr/include/*
	rm -rf usr/lib/*
	rm -rf usr/share/*
	rm -rf usr/lib64/*
	rm -rf usr/bin/*
	if [ -f extra/kyotocabinet-1.2.77/Makefile ]; then $(MAKE) -C ./extra/kyotocabinet-1.2.77 distclean; fi;
	rm -rf extra/snappy-1.1.7/build
	$(MAKE) -C ./extra/lz4-1.9.2 PREFIX=`pwd`/usr/ clean
	$(MAKE) -C ./extra/zstd-1.4.3 PREFIX=`pwd`/usr/ uninstall
	$(MAKE) -C ./extra/zstd-1.4.3 PREFIX=`pwd`/usr/ clean
	$(MAKE) -C ./extra/fuel cleandep
