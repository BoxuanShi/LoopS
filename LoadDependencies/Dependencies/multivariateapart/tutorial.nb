 RowBox[{"Get", "[", 
  RowBox[{
   RowBox[{"NotebookDirectory", "[", "]"}], "<>", 
   "\"\<MultivariateApart.wl\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.836462898287416*^9, 3.836462958653121*^9}, {
   3.836632724708544*^9, 3.8366327248837347`*^9}, 3.83663296309302*^9, {
