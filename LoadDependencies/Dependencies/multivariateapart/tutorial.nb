Cell["\<\
The \[OpenCurlyDoubleQuote]all-in-one\[CloseCurlyDoubleQuote] function \
MultivariateApart may be all you need.\
\>", "Text",
 CellChangeTimes->{{3.836633029970941*^9, 3.836633046498897*^9}, {
  3.836641665412187*^9, 3.836641740852305*^9}, {3.836641776931596*^9, 
  3.836641784004076*^9}, {3.8372645693429832`*^9, 3.837264798800363*^9}, {
  3.8372654193518267`*^9, 
  3.837265419799877*^9}},ExpressionUUID->"738e7ff6-7eeb-4256-90c6-\
c18406843c52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MultivariateApart", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", "x"}], "-", "y"}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"y", 
     RowBox[{"(", 
      RowBox[{"x", "+", "y"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"x", "-", "y"}], ")"}]}], ")"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.837190263644704*^9, {3.8371902971408997`*^9, 3.837190298031122*^9}, {
   3.8371904027551937`*^9, 3.837190404977427*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"c2bc68ec-f829-4917-8f98-addbfce57827"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "y"}], ")"}], " ", "y"}]], "+", 
  FractionBox["3", 
   RowBox[{"2", " ", "y", " ", 
    RowBox[{"(", 
     RowBox[{"x", "+", "y"}], ")"}]}]]}]], "Output",
 CellChangeTimes->{3.837190266546712*^9, 3.837190298620822*^9, 
  3.8371904078661613`*^9, 3.8372547267827597`*^9, 3.837274800545982*^9, 
  3.83727951870015*^9, 3.837279783920751*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"9a709318-3be7-4350-8bcc-aab0d892a6d0"]
}, Open  ]],

Cell["\<\
For a given rational function or sum of rational functions, MultivariateApart \
successively finds all denominator factors, abbreviates their inverses, \
calculates the Groebner basis and performs the reduction. The output is \
unique after a subsequent call to Expand. You can keep the abbreviations by \
using MultivariateAbbreviatedApart.\
\>", "Text",
 CellChangeTimes->{{3.837264800693427*^9, 3.837264834192034*^9}, {
  3.837264872354553*^9, 3.837264874192868*^9}, {3.837265089539266*^9, 
  3.837265123778186*^9}, {3.837265402775716*^9, 
  3.837265422439972*^9}},ExpressionUUID->"efd6b769-dd29-4162-b33f-\
a72c1f0aca71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MultivariateAbbreviatedApart", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "x"}], "-", "y"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"y", 
      RowBox[{"(", 
       RowBox[{"x", "+", "y"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", "y"}], ")"}]}], ")"}]}], "]"}], "//", 
  "Normal"}]], "Input",
 CellChangeTimes->{{3.837161763471814*^9, 3.837161763474453*^9}, {
   3.837188795807506*^9, 3.8371888018389072`*^9}, 3.837190416902742*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"095946f2-090e-43e3-916a-935926b0efb8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"q1", " ", "q2"}], "2"], "+", 
    FractionBox[
     RowBox[{"3", " ", "q2", " ", "q3"}], "2"]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"q1", "\[Rule]", 
      FractionBox["1", 
       RowBox[{"x", "-", "y"}]]}], ",", 
     RowBox[{"q2", "\[Rule]", 
      FractionBox["1", "y"]}], ",", 
     RowBox[{"q3", "\[Rule]", 
      FractionBox["1", 
       RowBox[{"x", "+", "y"}]]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.837188802480528*^9, 3.837190417659032*^9, 
  3.837254727468665*^9, 3.837274800785667*^9, 3.837279518770527*^9, 
  3.837279783931363*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"5fe229aa-ebef-4900-b526-764574a65ab7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Advanced usage example", "Section",
 CellChangeTimes->{{3.837264486000395*^9, 3.837264493902061*^9}, 
   3.8372671032275476`*^9},ExpressionUUID->"d1cddcab-4eae-417c-be5f-\
ecda1eb4e378"],

Cell["\<\
In the following, we describe a more advanced usage of our package, splitting \
the partial fraction decomposition into individual steps.\
\>", "Text",
 CellChangeTimes->{{3.836633238850211*^9, 3.836633297283578*^9}, {
   3.836641694493113*^9, 3.836641699956305*^9}, 3.836641800307962*^9, {
   3.837264889648506*^9, 3.837265072900263*^9}, {3.837267108347582*^9, 
   3.837267109899708*^9}},ExpressionUUID->"e4e96928-7dc1-42b0-8bc2-\
05e6e32c1536"],

Cell["\<\
First, AbbreviateDenominators returns a polynomial representation the \
rational function in the argument, the irredudible denominator factors, and \
the symbols representing the inverse denominator factors.\
\>", "Text",
 CellChangeTimes->{{3.836633238850211*^9, 3.836633297283578*^9}, {
   3.836641694493113*^9, 3.836641699956305*^9}, 3.836641800307962*^9, {
   3.837264889648506*^9, 3.83726506895732*^9}, {3.8372651592686777`*^9, 
   3.837265199937983*^9}, {3.837265276006222*^9, 
   3.837265400648032*^9}},ExpressionUUID->"bbb48446-e684-445c-9c1b-\
6e4945003d40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"expr", ",", "dens", ",", "qis"}], "}"}], "=", 
  RowBox[{"AbbreviateDenominators", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "x"}], "-", "y"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"y", 
      RowBox[{"(", 
       RowBox[{"x", "+", "y"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", "y"}], ")"}]}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8366332140872927`*^9, 3.8366332193634872`*^9}, {
  3.837188812354219*^9, 3.837188818352302*^9}, {3.837189204308732*^9, 
  3.8371892072345657`*^9}, {3.837190444103718*^9, 3.8371904493140173`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"140309be-c30c-4851-b970-09780afb6e96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"q1", " ", "q2", " ", "q3", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "x"}], "-", "y"}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "-", "y"}], ",", "y", ",", 
     RowBox[{"x", "+", "y"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.8366332305611973`*^9, 3.836641867450962*^9, 
  3.8371888210185537`*^9, 3.837189212548799*^9, 3.837190450573751*^9, 
  3.83725574509511*^9, 3.837257098808003*^9, 3.837267011591361*^9, 
  3.837274800824844*^9, 3.8372795187813797`*^9, 3.8372797839610357`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"8ec05337-4ca6-4858-8c73-99dd88d2ad59"]
}, Open  ]],

Cell["\<\
ApartOrder gives the suggested monomial ordering as described in Section 3.2 \
of our paper.\
\>", "Text",
