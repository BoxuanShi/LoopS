 CellLabel->"In[1]:=",ExpressionUUID->"c72623f2-7582-422e-a942-2a2ee481ad5f"],

Cell["\<\
MultivariateApart -- Multivariate partial fractions. By Matthias Heller \
(maheller@students.uni-mainz.de) and Andreas von Manteuffel (vmante@msu.edu). \
Version 2021-01-18. Please see ?MultivariateApart and ?MultivariateApart`* \
for help.\
\>", "Print",
 CellFrame->0.5,
 CellChangeTimes->{3.837279783592416*^9},
 FontColor->RGBColor[
  0.09375, 0.26953125, 
   0.23046875],ExpressionUUID->"198b2b77-f354-4c62-a786-c13c10b48130"]
}, Open  ]],

