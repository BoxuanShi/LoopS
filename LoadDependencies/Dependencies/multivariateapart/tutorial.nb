  3.8372801419203978`*^9, 3.8372801921367073`*^9}, {3.8372802344332867`*^9, 
  3.837280301073802*^9}, {3.837280365075244*^9, 
  3.837280394162462*^9}},ExpressionUUID->"ea2d0635-648b-4643-8c37-\
5f41c83adba3"],

