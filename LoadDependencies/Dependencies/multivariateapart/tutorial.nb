Cell["\<\
There is a significant reduction in expression size due to the partial \
fraction decomposition:\
\>", "Text",
 CellChangeTimes->{{3.837274687177865*^9, 
  3.8372747124421053`*^9}},ExpressionUUID->"6d94479d-298e-4c1a-bb93-\
f4834f0c2e9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ByteCount", "/@", 
  RowBox[{"{", 
   RowBox[{"expr", ",", "red1", ",", "red2", ",", "red3"}], "}"}]}]], "Input",\

 CellChangeTimes->{{3.837274630187622*^9, 3.837274678205599*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"fe607592-3154-4b0f-a8d0-1c4693a37d08"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"173064", ",", "5000", ",", "5000", ",", "5800"}], "}"}]], "Output",\

 CellChangeTimes->{{3.8372746401782923`*^9, 3.837274679651291*^9}, 
   3.8372748055358763`*^9, 3.837279524299281*^9, 3.837279787681555*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"92e222ae-37a7-4f0d-85c7-5bb96ca38bdc"]
}, Open  ]],

Cell["Let us compare the output expressions.", "Text",
 CellChangeTimes->{{3.8372700200351677`*^9, 3.837270079046142*^9}, {
  3.837274716299533*^9, 
  3.83727472386685*^9}},ExpressionUUID->"e155272d-3ae6-4517-ba62-\
edf5369c851b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"diffs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"red1", "-", "red2"}], ",", 
     RowBox[{"red1", "-", "red3"}], ",", 
     RowBox[{"red2", "-", "red3"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.837268421165394*^9, 3.837268434955394*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"cb257d44-c31c-4fd7-9951-16640a9d186c"],

Cell["\<\
The outputs are essentially the same, but due to slight differences in the \
treatment of factors not necessarily identical at this point.\
\>", "Text",
 CellChangeTimes->{{3.837270046240996*^9, 3.837270072048441*^9}, {
  3.837270125728405*^9, 3.8372702379052153`*^9}, {3.837274733610568*^9, 
  3.837274744186846*^9}},ExpressionUUID->"4978bd80-5d7e-42c3-9559-\
ce17f7f3bffe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"#", "===", "0"}], ")"}], "&"}], "/@", "diffs"}]], "Input",
 CellChangeTimes->{{3.8372683608444977`*^9, 3.837268391819542*^9}, {
  3.837268544683526*^9, 3.837268569259838*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"b76cb66b-5e35-4f69-abbe-a95347c91785"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.837273026296135*^9, 3.837274805584819*^9, 
  3.8372795243754787`*^9, 3.8372797877375183`*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"dce1a784-01bf-47fa-9348-87c7ecd742ea"]
}, Open  ]],

Cell["\<\
A simple Expand eliminates those differences and guarantees a unique \
representation.\
\>", "Text",
 CellChangeTimes->{{3.837270083984078*^9, 3.8372701119686832`*^9}, {
  3.83727024297789*^9, 
  3.837270251513194*^9}},ExpressionUUID->"bcc933b5-9492-4b3f-a3a6-\
a19c8ddf97a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Expand", "[", "#", "]"}], "===", "0"}], ")"}], "&"}], "/@", 
  "diffs"}]], "Input",
 CellChangeTimes->{{3.8372683608444977`*^9, 3.837268391819542*^9}, {
  3.837268544683526*^9, 3.837268582412043*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"5fa417b3-9285-4f94-81b8-db86e6c19d3e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.837273028655984*^9, 3.837274805596115*^9, 
  3.837279524383733*^9, 3.837279787749701*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"116aeef5-37ad-4a03-aa26-df301175f616"]
}, Open  ]],

Cell[TextData[{
 "Here, we include also the partial fractioned result (B.3) of  ",
 ButtonBox["https://arxiv.org/abs/2008.13194",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2008.13194"], None},
  ButtonNote->"https://arxiv.org/abs/2008.13194"],
 " "
}], "Text",
 CellChangeTimes->{{3.837272051737845*^9, 3.8372721086207037`*^9}, {
  3.837272616926866*^9, 
  3.837272624399379*^9}},ExpressionUUID->"4f7c33f6-71f9-4f0f-b350-\
db62c8374079"],

Cell[BoxData[
 RowBox[{
  RowBox[{"altpfd", "=", 
   RowBox[{
    RowBox[{"4", "/", "s12"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "*", "s15"}], "-", 
       RowBox[{"2", "*", "s34"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"s12", "*", "s23"}], ")"}]}], "+", 
    RowBox[{"15", "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s15", "+", "s34"}], ")"}]}], ")"}]}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"15", "*", "s15"}], "-", 
       RowBox[{"15", "*", "s34"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"8", "*", "s23", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s15", "+", "s34"}], ")"}]}], ")"}]}], 
    "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"7", "*", "s23"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "s12", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}]}], ")"}]}], 
    "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"15", "*", "s23"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s15", "+", "s34"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}]}], ")"}]}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "*", "s34"}], ")"}], "/", 
     RowBox[{"s45", "^", "2"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "*", 
       RowBox[{"s34", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}], "*", 
       RowBox[{"s45", "^", "2"}]}], ")"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", "s23", "*", 
       RowBox[{"s34", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"s12", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}], "*", 
       RowBox[{"s45", "^", "2"}]}], ")"}]}], "-", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", "s45"}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"s12", "*", "s45"}], ")"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"4", "*", "eps"}]}], ")"}], "*", "s12", "*", "s45"}], 
      ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"15", "*", "s15"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"8", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s15", "+", "s34"}], ")"}], "*", "s45"}], 
      ")"}]}], "+", 
    RowBox[{"s34", "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}], "*", "s45"}], 
      ")"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"11", "*", "s23", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "s12", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}], "*", "s45"}], 
      ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "*", "s23", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"4", "*", "eps"}]}], ")"}], "*", "s12", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}], "*", "s45"}], 
      ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"15", "*", 
        RowBox[{"s15", "^", "2"}]}], "-", 
       RowBox[{"15", "*", "s15", "*", "s34"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"8", "*", "s23", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s15", "+", "s34"}], ")"}], "*", "s45"}], 
      ")"}]}], "+", 
    RowBox[{"5", "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s45"}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s23", "*", 
       RowBox[{"s34", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}], "*", 
       RowBox[{"s45", "^", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s45"}], ")"}]}], ")"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"11", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", "s45", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s45"}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"s23", "*", "s34"}], "+", 
       RowBox[{"s34", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s15"}], "+", "s23", "+", "s34"}], ")"}], "*", "s45", 
       "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s45"}], ")"}]}], ")"}]}], "+", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}], ")"}]}], ")"}]}], 
    "-", 
    RowBox[{"s15", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "s12", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}], ")"}]}], ")"}]}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"7", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", "s23", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}], ")"}]}], ")"}]}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s15", "-", "s23", "-", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"s45", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}], ")"}]}], ")"}]}], 
    "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"5", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s45"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "-", "s23", "+", "s45"}], ")"}]}], ")"}]}], 
    "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s23", "-", "s45"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "s12", "*", 
       RowBox[{"(", 
        RowBox[{"s15", "-", "s23", "+", "s45"}], ")"}]}], ")"}]}], "-", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"s34", "+", "s45"}], ")"}]}], ")"}]}], "+", 
    RowBox[{"s45", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"s15", "-", "s23", "+", "s45"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"s34", "+", "s45"}], ")"}]}], ")"}]}], "-", 
    RowBox[{"15", "/", 
     RowBox[{"(", 
      RowBox[{"8", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s34", "+", "s45"}], ")"}]}], ")"}]}], 
    "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"15", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"8", "*", "s23", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s34", "+", "s45"}], ")"}]}], ")"}]}], 
    "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"15", "*", "s15", "*", "s34"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"8", "*", "s23", "*", "s45", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "s12"}], "+", "s34", "+", "s45"}], ")"}]}], ")"}]}]}]}],
   ";"}]], "Input",
