  3.837283225519166*^9}},ExpressionUUID->"1b93c2fb-2f24-42d1-8c2d-\
7ff62a11c487"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Timing", "[", 
   RowBox[{"red3", "=", 
    RowBox[{"ApartReduce", "[", 
     RowBox[{"expr", ",", "gb", ",", "ord", ",", 
      RowBox[{"UseFormProgram", "\[Rule]", "True"}]}], "]"}]}], "]"}], "[", 
