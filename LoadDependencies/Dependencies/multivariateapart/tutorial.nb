Cell["\<\
This generates the file \[OpenCurlyDoubleQuote]apartbasisin.sing\
\[CloseCurlyDoubleQuote] which can be executed with \
\[OpenCurlyDoubleQuote]Singular apartbasisin.sing\[CloseCurlyDoubleQuote]. \
The input file contains the definition of the ideal and the commands to \
compute the Groebner basis.\
\>", "Text",
 CellChangeTimes->{{3.836974512008934*^9, 3.836974570552889*^9}, {
  3.837267254859887*^9, 
  3.837267322576582*^9}},ExpressionUUID->"6336397d-1202-4c0e-8bae-\
d9af3fe39605"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ReadString", "[", 
  RowBox[{
   RowBox[{"NotebookDirectory", "[", "]"}], "<>", 
   "\"\<apartbasisin.sing\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.836974104106923*^9, 3.836974105865724*^9}, {
   3.836974142617682*^9, 3.8369741507304983`*^9}, {3.836974182986681*^9, 
   3.836974209356275*^9}, 3.836974260354073*^9, {3.836974366699541*^9, 
   3.836974381433984*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"b463c2c7-cc1c-4a7c-bf74-b6b91584dbc0"],

Cell[BoxData["\<\"ring \
myring=0,\\n(q12,q14,q15,q13,q8,q9,q16,q11,q10,q7,q6,q5,q3,q1,q2,q4,m2,sll,t1,\
t2,tll),\\n(dp(5),dp(2),dp(1),dp(1),dp(1),dp(1),dp(1),dp(1),dp(1),dp(1),dp(1),\
dp(5));\\npoly mygen1=1-q1*t1;\\npoly mygen2=1-q2*sll;\\npoly mygen3=1-q3*t2;\
\\npoly mygen4=1-m2*q4;\\npoly mygen5=1-q5*tll;\\npoly mygen6=1-q6*(4*m2 - \
sll);\\npoly mygen7=1-q7*(-m2 + tll);\\npoly mygen8=1-q8*(m2 - sll + t1 + t2 \
- tll);\\npoly mygen9=1-q9*(sll^2 - 2*sll*t1 + t1^2 - 2*sll*t2 - 2*t1*t2 + \
t2^2);\\npoly mygen10=1-q10*(m2^2 - 2*m2*t1 + t1^2 - 2*m2*tll - 2*t1*tll + \
tll^2);\\npoly mygen11=1-q11*(m2^2 - 2*m2*t2 + t2^2 - 2*m2*tll - 2*t2*tll + \
tll^2);\\npoly mygen12=1-q12*(m2^2*sll - m2*sll*t1 + m2*t1^2 - m2*sll*t2 - \
2*m2*t1*t2 + sll*t1*t2 + m2*t2^2 - 2*m2*sll*tll + sll^2*tll - sll*t1*tll - \
sll*t2*tll + sll*tll^2);\\npoly mygen13=1-q13*(2*m2 - sll + t1 + t2 - \
tll);\\npoly mygen14=1-q14*(m2^2 - 2*m2*sll + sll^2 - 4*m2*t1 + 2*m2*t2 - \
2*sll*t2 + t2^2 - 2*m2*tll + 2*sll*tll - 2*t2*tll + tll^2);\\npoly \
mygen15=1-q15*(m2^2 - 2*m2*sll + sll^2 + 2*m2*t1 - 2*sll*t1 + t1^2 - 4*m2*t2 \
- 2*m2*tll + 2*sll*tll - 2*t1*tll + tll^2);\\npoly mygen16=1-q16*(sll - t1 - \
t2);\\nideal \
myideal=mygen1,mygen2,mygen3,mygen4,mygen5,mygen6,mygen7,mygen8,mygen9,\
mygen10,mygen11,mygen12,mygen13,mygen14,mygen15,mygen16;\\nideal mygb = \
slimgb(myideal);\\nlink outfile = \\\"ASCII:w \
/Users/andreas/repos/multivariateapart/apartbasisout.m\\\";\\nwrite(outfile, \
\\\"{\\\", mygb, \\\"}\\\");\\nclose(outfile);\\nquit;\\n\"\>"], "Output",
 CellChangeTimes->{3.837267335842785*^9, 3.837274802468707*^9, 
  3.837279521129887*^9, 3.8372797849349203`*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"b3ae0d7a-a2fb-4751-81ac-9ab944a883e7"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Iterated reductions and interface with Form", "Section",
 CellChangeTimes->{{3.836974846136651*^9, 3.836974852328072*^9}, {
  3.836975634276534*^9, 3.8369756428527*^9}, {3.8372745538317547`*^9, 
  3.837274556519823*^9}},ExpressionUUID->"95dd8d70-af11-478c-88e2-\
d4165b768b45"],

Cell[TextData[{
 "Here, we consider the partial fraction decomposition of a more involved \
rational function. Specifically, we consider the example discussed equation \
(B.2) of ",
 ButtonBox["https://arxiv.org/abs/2008.13194",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2008.13194"], None},
  ButtonNote->"https://arxiv.org/abs/2008.13194"],
 " . This rational function appears in the IBP reduction of a non-planar \
2-loop integral for massless 5-point scattering and corresponds to entry \
(24,107) of the matrix \[OpenCurlyDoubleQuote]IBPmatrix_dlog_basis_scaled.txt\
\[CloseCurlyDoubleQuote] presented in ",
 ButtonBox["https://arxiv.org/pdf/1908.04301.pdf",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1908.04301.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1908.04301.pdf"],
 " . In this example, dimensionful kinematic variables s12,... are used. If \
performance is important, one should consider to work with dimensionless \
ratios instead, see also the discussion in the cited literature above.\
\[LineSeparator]In the following, we demonstrate how the iterated reduction \
scheme and the external Form program can be used for the partial fraction \
decomposition. While these options are not very useful for this relatively \
small example, they may help to signficantly speed up the computation for \
more involved applications, see table 1 of our paper."
}], "Text",
 CellChangeTimes->{{3.837267481830811*^9, 3.837267810789156*^9}, {
  3.8372679764551573`*^9, 3.837268087223221*^9}, {3.837268696638*^9, 
  3.837268714215418*^9}, {3.8372719223801622`*^9, 3.8372720427455873`*^9}, {
  3.837272262459608*^9, 3.837272266251792*^9}, {3.8372726363992968`*^9, 
  3.837272956595677*^9}, {3.8372734860621147`*^9, 3.837273525806126*^9}, {
  3.8372735808955097`*^9, 3.83727360470299*^9}, {3.837274334645385*^9, 
  3.837274416741788*^9}, {3.837274448983053*^9, 3.837274599145219*^9}, {
  3.83728004917003*^9, 
  3.837280052032254*^9}},ExpressionUUID->"7477ba4b-6c97-4cf1-836e-\
826a13a46ae2"],

