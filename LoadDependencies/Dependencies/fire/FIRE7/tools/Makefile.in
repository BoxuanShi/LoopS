include ../paths.inc
vpath %.cpp ../sources/
vpath %.cu ../sources/
vpath %.h ../sources/

NVCC=nvcc
HIPCC=hipcc
CUDALIBDIR := $(shell which ${NVCC} | sed 's/bin\/nvcc/lib64/g')

ifdef BUILD_OPENMPI
MCXX=../usr/bin/mpicxx
else
MCXX=mpicxx
endif

CFLAGS    = -O3 -g -DMPRIME=${RESULTING_MPRIME_COUNT} -Wall -Werror -Wno-error=alloc-size-larger-than= -Wextra -Wpedantic -Wno-strict-aliasing -Wno-unused-parameter -std=c++17 -I/usr/local/include -isystem../usr/include -isystem../extra/fuel/usr/include/ -Wno-cast-function-type -fopenmp

HIPCFLAGS  = -O3 -g -DMPRIME=${RESULTING_MPRIME_COUNT} -Wall -Werror -Wextra -Wpedantic -Wno-strict-aliasing -Wno-unused-parameter -std=c++17 -I/usr/local/include -isystem../usr/include -isystem../extra/fuel/usr/include/ -Wno-cast-function-type -fopenmp

NVCCFLAGS = -O3 -g -DMPRIME=${RESULTING_MPRIME_COUNT} -std=c++11 -I/usr/local/include -isystem ../usr/include -isystem ../extra/fuel/usr/include/ -DWITH_DEBUG --ptxas-options=-v

UNAME_S := $(shell uname -s)

ifeq ($(UNAME_S),Darwin)
LFLAGS = -rdynamic -L../usr/lib64/ -L../extra/fuel/usr/lib/ -L../usr/lib/ -lfuel -lflint -L/usr/local/lib -lgmpxx -lgmp -fopenmp -lpthread
else
LFLAGS = -rdynamic -L../usr/lib64/ -L../extra/fuel/usr/lib/ -L../usr/lib/ -Wl,-Bstatic -lfuel -Wl,-Bdynamic -lflint -lmpfr -lgmp -lgmpxx -L/usr/local/lib -fopenmp -lpthread -ldl '-Wl,-rpath,$$ORIGIN/../usr/lib/' '-Wl,-rpath,$$ORIGIN/../usr/lib64/' '-Wl,-rpath,$$ORIGIN/../extra/fuel/usr/lib/'
endif

HIPLFLAG = -L/opt/rocm/lib -L./tools/ -lamdhip64

OBJ = tools/tables.o tools/tools.o tools/primes.o

ifdef ENABLE_FIRE7NP
default: combine diff add substitute lcm reconstruct tables2rules topo_sort
else
default: combine diff add substitute lcm reconstruct tables2rules
endif

gpu: reconstruct_gpu

mpi: FIRE7_MPI reconstruct_mpi

mpi_gpu: FIRE7_MPI_GPU reconstruct_mpi_gpu reconstruct_gpu

gpu_mpi: FIRE7_MPI_GPU reconstruct_mpi_gpu

FIRE7_MPI: $(OBJ) tools/mpi_wrapper.o tools/reconstruction_mpi.o
	${MCXX} $(OBJ) tools/mpi_wrapper.o tools/reconstruction_mpi.o ${LFLAGS} -o FIRE7_MPI

FIRE7_MPI_GPU: $(OBJ) tools/mpi_wrapper.o tools/reconstruction_mpi_gpu.o tools/gpu.o
	${MCXX} $(OBJ) tools/mpi_wrapper.o tools/reconstruction_mpi_gpu.o tools/gpu.o -L${CUDALIBDIR} -lcudart ${LFLAGS} -o FIRE7_MPI_GPU

reconstruct_mpi: $(OBJ) tools/reconstruct_mpi.o tools/reconstruction_mpi.o
	${MCXX} $(OBJ) tools/reconstruct_mpi.o tools/reconstruction_mpi.o ${LFLAGS} -o reconstruct_mpi

reconstruct_mpi_gpu: $(OBJ) tools/reconstruct_mpi.o tools/reconstruction_mpi_gpu.o tools/gpu.o ../usr/lib/libfuel.a
	${MCXX} $(OBJ) tools/reconstruct_mpi.o tools/reconstruction_mpi_gpu.o tools/gpu.o -L${CUDALIBDIR} -lcudart ${LFLAGS} -o reconstruct_mpi_gpu

tools/mpi_wrapper.o: tools/mpi_wrapper.cpp
	${MCXX} ${CFLAGS} -c $< -o $@

reconstruct_gpu: $(OBJ) tools/reconstruct.o tools/reconstruction_gpu.o tools/gpu.o ../usr/lib/libfuel.a
	${CCPLUS} $(OBJ) tools/reconstruct.o tools/reconstruction_gpu.o tools/gpu.o -L${CUDALIBDIR} -lcudart ${LFLAGS} -o reconstruct_gpu

reconstruct_amd_gpu: $(OBJ) tools/reconstruct.o tools/reconstruction_gpu.o tools/amd_gpu.o ../usr/lib/libfuel.a
	${CCPLUS} $(OBJ) tools/reconstruct.o tools/reconstruction_gpu.o tools/amd_gpu.o ${LFLAGS} ${HIPLFLAG} -o reconstruct_amd_gpu

reconstruct: $(OBJ) tools/reconstruct.o tools/reconstruction.o ../usr/lib/libfuel.a
	${CCPLUS} $(OBJ) tools/reconstruct.o tools/reconstruction.o ${LFLAGS} -o reconstruct

tools/reconstruct_mpi.o: tools/reconstruct.cpp
	${MCXX} -DWITH_MPI ${CFLAGS} ${INCDIR} -c $< -o $@

tools/reconstruction_mpi.o: tools/reconstruction.cpp
	${MCXX} -DWITH_MPI ${CFLAGS} ${INCDIR} -c $< -o $@

tools/reconstruction_mpi_gpu.o: tools/reconstruction.cpp
	${MCXX} -DWITH_MPI -DWITH_GPU ${CFLAGS} ${INCDIR} -c $< -o $@

tools/reconstruction_gpu.o: tools/reconstruction.cpp
	${CCPLUS} -DWITH_GPU ${CFLAGS} ${INCDIR} -c $< -o $@

diff: $(OBJ) tools/diff.o ../usr/lib/libfuel.a
	${CCPLUS} $(OBJ) tools/diff.o ${LFLAGS} -o diff

add: $(OBJ) tools/add.o ../usr/lib/libfuel.a
	${CCPLUS} $(OBJ) tools/add.o ${LFLAGS} -o add

combine: $(OBJ) tools/combine.o ../usr/lib/libfuel.a
	${CCPLUS} $(OBJ) tools/combine.o ${LFLAGS} -o combine

substitute: $(OBJ) tools/substitute.o ../usr/lib/libfuel.a
	${CCPLUS} $(OBJ) tools/substitute.o ${LFLAGS} -o substitute

lcm: ${OBJ} tools/lcm.o
	${CCPLUS} $(OBJ) tools/lcm.o ${LFLAGS} -o lcm

tools/amd_gpu.o: tools/gpu.cu
	${HIPCC} -fPIE ${HIPCFLAGS} ${INCDIR} -c $< -o $@

tools/gpu.o: tools/gpu.cu
	${NVCC} ${NVCCFLAGS} ${INCDIR} -c $< -o $@

tables2rules: $(OBJ) tools/tables2rules.o
	${CCPLUS} $(OBJ) tools/tables2rules.o ${LFLAGS} -o tables2rules

topo_sort: $(OBJ) tools/topo_sort.o
	${CCPLUS} $(OBJ) tools/topo_sort.o ${LFLAGS} -o topo_sort

.cpp.o:
	${CCPLUS} ${CFLAGS} ${INCDIR} -c $< -o $@

clean:
	rm -f ./*.o combine diff add reconstruct tables2rules topo_sort
	rm -f ./tools/*.o combine diff add reconstruct tables2rules topo_sort
	rm -f ../sources/topo_sort.cpp

../sources/tools/topo_sort.cpp: ../../FIRE7np/sources/topo_sort.cpp
	cp ../../FIRE7np/sources/topo_sort.cpp ../sources/tools/

tools/diff.o: ../sources/tools/diff.cpp
tools/add.o: ../sources/tools/add.cpp
tools/combine.o: ../sources/tools/combine.cpp
tools/substitute.o: ../sources/tools/substitute.cpp
tools/lcm.o: ../sources/tools/lcm.cpp
tools/topo_sort.o: ../sources/tools/topo_sort.cpp
tools/gpu.o: ../sources/tools/gpu.h
tools/reconstruct.o: ../sources/tools/reconstruct.cpp
tools/tables.o: ../sources/tools/tables.cpp
tools/diff.o: ../sources/tools/diff.cpp
tools/add.o: ../sources/tools/add.cpp
tools/combine.o: ../sources/tools/combine.cpp
tools/tools.o: ../sources/tools/tools.cpp
tools/diff.o: ../sources/tools/tables.h
tools/add.o: ../sources/tools/tables.h
tools/combine.o: ../sources/tools/tables.h
tools/recosntruction.o: ../sources/tools/tables.h
tools/recosntruction_mpi.o: ../sources/tools/tables.h
tools/recosntruction_gpu.o: ../sources/tools/tables.h
tools/recosntruction_gpu.o: ../sources/tools/gpu.h
tools/substitute.o: ../sources/tools/tables.h
tools/lcm.o: ../sources/tools/tables.h
tools/diff.o: Makefile
tools/add.o: Makefile
tools/combine.o: Makefile
tools/lcm.o: Makefile
tools/reconstruct.o: Makefile
tools/tables.o: Makefile
tools/tools.o: Makefile
tools/tables2rules.o: Makefile
tools/mpi_wrapper.o: Makefile
tools/gpu.o: Makefile
