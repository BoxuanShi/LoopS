include ../paths.inc
vpath %.cpp ../sources
vpath %.h ../sources
vpath %.inl ../sources

CFLAGS = -O3 -g -flto -Wall -Wextra -Wpedantic -Werror -Wno-error=alloc-size-larger-than= -Wno-strict-aliasing -Wno-unused-parameter -std=c++17 -isystem../usr/include -isystem../extra/fuel/usr/include/  ${NP_INCLUDE} -DSMALL_POINT -DLARGE_POINT -DMANY_SECTORS -DWITH_DEBUG -DWITH_SNAPPY -DWITH_ZSTD -DWITH_ZLIB -DPRIME -DMPRIME=${RESULTING_MPRIME_COUNT} -fopenmp -fno-builtin-malloc -fno-builtin-calloc -fno-builtin-realloc -fno-builtin-free

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
LFLAGS = -rdynamic -L../usr/lib/ -L../extra/fuel/usr/lib/ -L../usr/lib64/ -ltcmalloc_minimal -lkyotocabinet -lsnappy -lfuel -lsymbolica -lflint ../usr/lib/liblz4.a -lc++ -lcln -lginac -lgmp -fopenmp -lpthread -lm -lz -lc -lzstd
else
LFLAGS = -flto -O3 -g -rdynamic -L../usr/lib/ -L../extra/fuel/usr/lib/ -L../usr/lib64/ -Wl,-Bstatic -ltcmalloc_minimal -lkyotocabinet -lsnappy -lfuel -lsymbolica -l:liblz4.a -static-libstdc++ -Wl,-Bdynamic -lflint -lmpfr -lgmp -lcln -lginac -lstdc++ -lrt -fopenmp -lpthread -lm -lz -lc -ldl -lzstd '-Wl,-rpath,$$ORIGIN/../usr/lib/' '-Wl,-rpath,$$ORIGIN/../usr/lib64/' '-Wl,-rpath,$$ORIGIN/../extra/fuel/usr/lib/'
endif

MFLAGS = ../usr/lib/mimalloc-1.6/mimalloc.o

OBJ = point.o equation.o functions.o common.o parser.o

ifdef ENABLE_FIRE7NP
default: FIRE7 FLAME7 Ftool7 eqgen_external_solver
else
default: FIRE7 FLAME7 Ftool7
endif

TOOLS_OBJ = ../usr/lib/libfuel.a ../tools/tools/tools.o ../tools/tools/tables.o ../tools/tools/primes.o

FIRE7: $(OBJ) main.o ../usr/lib/libfuel.a $(TOOLS_OBJ)
	${CCPLUS} $(MFLAGS) $(OBJ) main.o $(TOOLS_OBJ) ${LFLAGS} -o FIRE7

FLAME7: $(OBJ) thread.o ../usr/lib/libfuel.a $(TOOLS_OBJ) 
	${CCPLUS} $(MFLAGS) $(OBJ) thread.o $(TOOLS_OBJ) ${LFLAGS} -o FLAME7

Ftool7: $(OBJ) ftool.o $(TOOLS_OBJ)
	${CCPLUS} $(MFLAGS) $(OBJ) ftool.o $(TOOLS_OBJ) ${LFLAGS} -o Ftool7

eqgen_external_solver: $(OBJ) eqgen_external_solver.o $(TOOLS_OBJ)
	${CCPLUS} $(MFLAGS) $(OBJ) eqgen_external_solver.o $(TOOLS_OBJ) ${LFLAGS} -o eqgen_external_solver

.cpp.o:
	${CCPLUS} ${CFLAGS} ${INCDIR} -c $< -o $@

clean:
	rm -f ./*.o test
	rm -f ../sources/eqgen_external_solver.cpp

../sources/eqgen_external_solver.cpp: ../../FIRE7np/sources/eqgen_external_solver.cpp
	cp ../../FIRE7np/sources/eqgen_external_solver.cpp ../sources/

point.o: point.cpp
equation.o: equation.cpp
functions.o: functions.cpp
main.o: main.cpp
point.o: point.h
equation.o: equation.h
equation.o: point.h
functions.o: functions.h
functions.o: equation.h
functions.o: point.h
main.o: functions.h
main.o: equation.h
main.o: point.h
point.o: common.h
common.o: common.h
equation.o: common.h
main.o: common.h
functions.o: parser.h
parser.o: common.h
parser.o: point.h
parser.o: equation.h
thread.o: functions.h
thread.o: equation.h
thread.o: point.h
ftool.o: functions.h
ftool.o: equation.h
ftool.o: point.h
main.o: handler.h
thread.o: handler.h
equation.o: equation.inl
point.o: Makefile
equation.o: Makefile
functions.o: Makefile
main.o: Makefile
thread.o: Makefile
ftool.o: Makefile
common.o: Makefile
eqgen_external_solver.o: Makefile
eqgen_external_solver.o: ../../FIRE7np/extra/TinySolve/src/tiny_solve.h
