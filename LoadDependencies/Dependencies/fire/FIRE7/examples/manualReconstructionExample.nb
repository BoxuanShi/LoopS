       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "yZippelLimit"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"reconstructBalancedZippelNewton", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"y", ",", " ", "y0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"d", ",", " ", "d0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"yZippelLimit", ",", " ", "dNewtonLimit"}], "}"}], ",", " ", 
       "n", ",", "  ", "\"\<myAmplitude.tables\>\""}], "]"}], ";"}], 
