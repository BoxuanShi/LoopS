Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reconstructForNthPrime", "[", "n_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"calculateAndExportVector", "[", 
        RowBox[{"myAmplitude", ",", " ", 
         RowBox[{"{", 
          RowBox[{"y0", ",", " ", "d0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1"}], "}"}], ",", " ", "n", ",", " ", 
         "\"\<myAmplitude.tables\>\""}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "yThieleLimit"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"calculateAndExportVector", "[", 
        RowBox[{"myAmplitude", ",", " ", 
         RowBox[{"{", 
          RowBox[{"y0", ",", " ", "d0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], ",", " ", "n", ",", " ", 
         "\"\<myAmplitude.tables\>\""}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", " ", ",", "yZippelLimit"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", " ", "dThieleLimit"}], "}"}]}], " ", 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"reconstructThiele", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"y", ",", "y0"}], "}"}], ",", " ", "d0"}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"yThieleLimit", ",", " ", "1"}], "}"}], ",", " ", "n", ",", 
       " ", "\"\<myAmplitude.tables\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"reconstructThiele", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"y0", ",", " ", 
