Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "this", " ", "file", " ", "demonstrates", " ", "the", " ", "reconstructon", 
   " ", "from", " ", "multiple", " ", "tables", " ", "for", " ", "different", 
   " ", "values", " ", "of", " ", "d", " ", "and", " ", "prime", " ", 
   "numbers"}], "*)"}]], "Input",
 CellChangeTimes->{{3.702196266234706*^9, 
  3.702196305441556*^9}},ExpressionUUID->"7dceff15-2439-4085-b3cb-\
14d533896aaf"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "to", " ", "see", " ", "results", " ", "first", " ", "run", " ", "the", " ",
    "script", " ", 
   RowBox[{"examples", "/", "run_box"}], "_prime", " ", "or", " ", 
   RowBox[{"examples", "/", "run_box"}], "_prime", "_mpi"}], " ", 
  "*)"}]], "Input",
 CellChangeTimes->{{3.7021963078798523`*^9, 3.702196338996435*^9}, {
  3.7572235746047363`*^9, 
  3.7572235828147163`*^9}},ExpressionUUID->"708be8a6-aa58-4654-8eb0-\
64c694622633"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
   "it", " ", "creates", " ", "multiple", " ", "tables", " ", "in", " ", 
    "the", " ", "folder", " ", "\"\<temp\>\"", " ", "named", " ", "as", " ", 
    "\"\<box-d-p.tables\>\""}], ",", " ", 
   RowBox[{
   "where", " ", "d", " ", "is", " ", "the", " ", "value", " ", "of", " ", 
    "d", " ", "from", " ", "100", " ", "to", " ", "125", " ", "and", " ", "p",
     " ", "is", " ", "the", " ", "prime", " ", "number"}]}], " ", 
  "*)"}]], "Input",
 CellChangeTimes->{{3.702196340608068*^9, 
  3.702196394970396*^9}},ExpressionUUID->"fa193344-7006-4590-94fa-\
43d179540b5b"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
   "prime", " ", "numbers", " ", "are", " ", "encoded", " ", "in", " ", 
    RowBox[{"primes", ".", "h"}]}], ",", " ", 
   RowBox[{"currently", " ", "they", " ", "correspond", " ", "to", " ", 
    RowBox[{"Prime", "[", 
     RowBox[{
      RowBox[{"2", "^", "40"}], " ", "+", " ", "n"}], "]"}]}]}], " ", 
  "*)"}]], "Input",
 CellChangeTimes->{{3.702196397721305*^9, 
  3.702196430963229*^9}},ExpressionUUID->"8d13491e-9d6c-4e98-b728-\
411021201eb5"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"after", " ", "running", " ", "the", " ", "script", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"it", " ", "will", " ", "take", " ", "some", " ", "time"}], ",", 
     " ", 
     RowBox[{"run", " ", "the", " ", "following", " ", "command"}]}], " "}]}],
   "*)"}]], "Input",
 CellChangeTimes->{{3.702196432414844*^9, 
  3.702196451450688*^9}},ExpressionUUID->"8da4fc49-71d3-47de-8c97-\
46801a6633f3"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "it", " ", "first", " ", "uses", " ", "rational", " ", "reconstruction", 
   " ", "to", " ", "create", " ", "tables", " ", "named", " ", "as", " ", 
   "\"\<box-d.tables\>\"", " ", "for", " ", "different", " ", "values", " ", 
   "of", " ", "d"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.7021964526305428`*^9, 
  3.702196489397703*^9}},ExpressionUUID->"ce1bf4ce-3822-477f-9a4f-\
605c66cd12a4"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "then", " ", "it", " ", "uses", " ", "Thiele", " ", "reconstruction", " ", 
   "to", " ", "get", " ", "standart", " ", "tables"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.702196491046022*^9, 
  3.702196510169754*^9}},ExpressionUUID->"b174b25f-197b-4831-9c69-\
0c4a381708f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"d", "=", "100"}], ",", " ", 
    RowBox[{"d", "<=", "125"}], ",", " ", 
    RowBox[{"++", "d"}], ",", "\[IndentingNewLine]", 
    RowBox[{"RationalReconstructTables", "[", 
     RowBox[{
      RowBox[{"\"\<tests/outputs/box_\>\"", "<>", 
       RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<_0.tables\>\""}], ",", 
      "4"}], "]"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "d", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ThieleReconstructTables", "[", 
  RowBox[{"\"\<tests/outputs/box_d_0.tables\>\"", ",", 
   RowBox[{"d", "->", 
    RowBox[{"Range", "[", 
     RowBox[{"100", ",", "125"}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.892261849328327*^9, 3.892261998471246*^9}, {
  3.892262200361678*^9, 3.892262204445305*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"4303846e-12d2-4dfa-93e7-7269b95a2f36"],

