#!/usr/bin/env wolframscript

(* The table will be written to `tests/outputs/mock_*.tables` *)

On[Assert];

$outputDir = FileNameJoin[{"tests", "outputs"}];
Assert[DirectoryQ[$outputDir]];

tableToReconstruct[{y_, d_}, prime_] := Module[{coeff1, coeff2, table},
    coeff1 = Together[((d+13)^30 * (y^2+9)^7 + 1) / ((d-4)^29 * (y^2-1)^5), Modulus->prime];
    table =
    {
      {
         {1, {{2, ToString[coeff1, InputForm]}}}
      },
      {
         {1, {1, {2,2,2}}},
         {2, {1, {1,1,1}}}
      }
    };
    Return[table]];

(* Accepted options and the number of arguments that follow. Currently "--variables" is the only implemented option. *)
$acceptedOptions = <|"--calc" -> 1, "--variables" -> 1, "-c" -> 1, "--quiet" -> 0, "--QUIET" -> 0, "--parallel" ->0, "--config" -> 1, "--large_variables" -> 0|>;

(* parse command-line arguments as a list of strings, and return an association for the values of the various options. *)
parseCommandLine[commandLine:{_String ..}, acceptedOptions_Association] :=
Module[{cmdOptions, i, currentArg},
    cmdOptions = <||>;
    (* starting from argument 2 since argument 1 is the script name *)
    i = 2;
    While[i < Length[commandLine],
        currentArg = commandLine[[i]];
        Assert[KeyExistsQ[acceptedOptions, currentArg]];
        If[acceptedOptions[currentArg] == 1,
            (        
            i = i + 1;
            Assert[i <= Length[commandLine]];
            cmdOptions[currentArg] = commandLine[[i]];
            ),
            (* else: a boolean option *)
            cmdOptions[currentArg] = True];
        i = i + 1];
    Return[cmdOptions]];

(* further process the result of parseCommandLine to extract the kinematic parameters and prime modulus *)
getKinematicsModulus[cmdOptions_Association] :=
Module[{variableValueString, variableValues, kinematicValues, prime},
    Assert[KeyExistsQ[cmdOptions, "--variables"]];
    variableValueString = cmdOptions["--variables"];
    variableValues = ToExpression /@ StringSplit[variableValueString, "_"];
    prime = $primes[[variableValues[[-1]] + 1]];
    kinematicValues = Together[#, Modulus -> prime] & /@ variableValues[[1;;-2]];
    Return[{kinematicValues, prime}]];

(* main function: parse command-line arguments and write table to file. *)
main[] :=
(
    $cmdOptions = parseCommandLine[$ScriptCommandLine, $acceptedOptions];
    Print["$cmdOptions = ", $cmdOptions];
    {$kinematicValues, $prime} = getKinematicsModulus[$cmdOptions];
    Print["{$kinematicValues, $prime} = ", {$kinematicValues, $prime}];

    $result = tableToReconstruct[$kinematicValues, $prime];

    Put[$result, FileNameJoin[{$outputDir, "mock_" <> $cmdOptions["--variables"] <> ".tables"}]]);

