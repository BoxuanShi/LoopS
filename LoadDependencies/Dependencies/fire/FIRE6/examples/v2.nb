Cell[BoxData[{
 RowBox[{
  RowBox[{"list", "=", 
   RowBox[{"MasterIntegrals", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Internal", "=", " ", 
   RowBox[{"{", 
    RowBox[{"l", ",", "r"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"External", "=", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", "q"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Propagators", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Power", "[", 
      RowBox[{"##", ",", "2"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "-", "r"}], ",", "l", ",", "r", ",", 
      RowBox[{"p", "-", "l"}], ",", 
      RowBox[{"q", "-", "r"}], ",", 
      RowBox[{"p", "-", "l", "+", "r"}], ",", 
      RowBox[{"q", "-", "r", "+", "l"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Replacements", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "^", "2"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"q", "^", "2"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"p", " ", "q"}], "->", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WriteRules", "[", 
   RowBox[{"list", ",", "\"\<examples/v2\>\""}], "]"}], ";"}]}], "Input",
