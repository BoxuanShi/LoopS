Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{
    RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<../\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", "\"\<extra/LiteRed/Setup/\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<LiteRed.m\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", "\"\<../../../\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<FIRE6.m\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Internal", "=", " ", 
   RowBox[{"{", 
    RowBox[{"l", ",", "r"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"External", "=", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", "q"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Propagators", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", 
       RowBox[{"Power", "[", 
        RowBox[{"##", ",", "2"}], "]"}]}], ")"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "-", "r"}], ",", "l", ",", "r", ",", 
      RowBox[{"p", "-", "l"}], ",", 
      RowBox[{"q", "-", "r"}], ",", 
      RowBox[{"p", "-", "l", "+", "r"}], ",", 
      RowBox[{"q", "-", "r", "+", "l"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Replacements", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "^", "2"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"q", "^", "2"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"p", " ", "q"}], "->", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"CreateNewBasis", "[", 
  RowBox[{"v2", ",", 
   RowBox[{"Directory", "\[Rule]", "\"\<temp/v2.dir\>\""}]}], "]"}]}], "Input",\

